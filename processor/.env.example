PROCESSOR_ENV=local
PROCESSOR_LOG_LEVEL=debug

# Pasteurizador
PASTEURIZADOR_STATE_FILE=/var/lib/santilac-pasteurizador/state.json
PASTEURIZADOR_CATCHUP_LOOKBACK_DAYS=14
FIELDLOGGER_MAX_BYTES=8000000
# A API aceita 6 coletas por minuto; 11s evita HTTP 429 durante o catch-up.
PASTEURIZADOR_CATCHUP_POST_INTERVAL_SECONDS=11
SANTILAC_POST_RETRY_ATTEMPTS=4
SANTILAC_POST_RETRY_BASE_DELAY_SECONDS=5
# Opcional: se vazio, o processor deriva /api/pasteurizador/sync-state a partir de SANTILAC_API_URL.
# SANTILAC_SYNC_STATE_URL=http://192.168.0.202/api/pasteurizador/sync-state
# Usado somente se ainda nao existir state.json.
# PASTEURIZADOR_CATCHUP_START_DATE=2026-06-18
