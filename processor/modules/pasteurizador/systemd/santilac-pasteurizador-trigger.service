[Unit]
Description=SantiLac pasteurizador - gatilho HTTP do coletor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/santilac-pasteurizador-processor
ExecStart=/usr/bin/python3 /opt/santilac-pasteurizador-processor/trigger_server.py
Restart=always
RestartSec=3
User=root
Environment=PYTHONUNBUFFERED=1
Environment=TZ=America/Sao_Paulo
StateDirectory=santilac-pasteurizador

[Install]
WantedBy=multi-user.target
