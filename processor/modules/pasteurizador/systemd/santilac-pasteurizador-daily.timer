[Unit]
Description=SantiLac pasteurizador - reconcilia coletas pendentes a cada hora

[Timer]
# O coletor consulta o ledger remoto antes de tocar no FieldLogger. Quando não
# há lacunas, esta execução é apenas um GET leve; quando uma tentativa falha,
# a próxima hora reconcilia automaticamente sem esperar o dia seguinte.
OnCalendar=*-*-* *:05:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30s
Unit=santilac-pasteurizador-daily.service

[Install]
WantedBy=timers.target
