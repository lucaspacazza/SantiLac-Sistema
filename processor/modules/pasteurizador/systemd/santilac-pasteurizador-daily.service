[Unit]
Description=SantiLac pasteurizador - coleta historico pendente
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/python3 /opt/santilac-pasteurizador-processor/collect_and_post.py --catch-up --timezone America/Sao_Paulo
WorkingDirectory=/opt/santilac-pasteurizador-processor
