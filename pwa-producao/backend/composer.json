{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "santilac/pwa-producao-backend",
    "type": "project",
    "description": "Backend minimo do PWA de producao da SantiLac.",
    "keywords": ["santilac", "pwa", "producao", "fabrica"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
